# Copy to .env.local for local development. On Vercel, set these under
# Project Settings → Environment Variables.

# --- Vercel Blob (image uploads + Get Started submission storage) ---
# Auto-populated by Vercel when a Blob store is connected to the project.
# For local dev, create a store (vercel.com/dashboard → Storage → Blob) and
# copy its token here.
BLOB_READ_WRITE_TOKEN=

# --- Resend (email notifications to aggrandizewebco@gmail.com) ---
RESEND_API_KEY=
# Verified sending address. Resend's shared onboarding@resend.dev works for
# testing but should be replaced with a domain-verified address before launch.
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- PayFast ---
# PAYFAST_MODE=sandbox uses PayFast's public sandbox test credentials
# (already defaulted in lib/payfast.js — no need to set the ID/key/passphrase
# below for sandbox testing). Set PAYFAST_MODE=live and fill in the three
# values below once the PayFast merchant account is verified.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=

# --- Site ---
# The site's absolute production origin. Used to build PayFast return/cancel/
# notify URLs, and as the single source for SITE.url (lib/content.js), which
# metadataBase, OG/Twitter image resolution, and the LocalBusiness structured
# data all read from — change it here, not by hunting for hardcoded domains
# across the app.
#
# Optional — leave unset and next.config.js falls back to Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL (the production domain already assigned to
# whichever Vercel project built the deployment), then to localhost for
# local dev. Set this explicitly once a custom domain is connected — no
# code change needed after that, just update this value.
NEXT_PUBLIC_SITE_URL=
