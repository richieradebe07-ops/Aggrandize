# Copy to .env.local for local development. On Vercel, set these under
# Project Settings → Environment Variables.

# --- Vercel Blob (image uploads + Get Started submission storage) ---
# Auto-populated by Vercel when a Blob store is connected to the project.
# For local dev, create a store (vercel.com/dashboard → Storage → Blob) and
# copy its token here.
BLOB_READ_WRITE_TOKEN=

# --- Resend (email notifications) ---
RESEND_API_KEY=
# Verified sending address — aggrandizeweb.co.za is already DKIM/SPF
# verified in Resend. Format: "Display Name <address@aggrandizeweb.co.za>".
FROM_EMAIL=
# Studio inbox that owner alerts (contact form, Get Started, Ask a
# question) are sent to, and that client confirmation emails reply-to.
NOTIFY_EMAIL=

# --- PayFast ---
# PAYFAST_MODE=sandbox uses PayFast's public sandbox test credentials
# (already defaulted in lib/payfast.js — no need to set the ID/key/passphrase
# below for sandbox testing) and shows a "TEST MODE" banner on every payment
# page. Going live after PayFast approves the merchant account is a single
# env change: set PAYFAST_MODE=live and fill in the three values below —
# no code change, no redeploy of different code.
PAYFAST_MODE=sandbox
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Kill switch for the payments UI (every "Pay deposit" link, /pay, and
# /pay/[token]) — separate from PAYFAST_MODE above, which only controls
# sandbox vs. live once payments are shown at all. Defaults to false
# (hidden, with a friendly "opening soon" message) while the PayFast
# merchant account verification is pending. NEXT_PUBLIC_-prefixed since
# client components (the Plans Walkthrough) need to read it directly.
# Flip to "true" once PayFast approves the account — no code change.
NEXT_PUBLIC_PAYMENTS_ENABLED=false

# --- Site ---
# The site's absolute production origin. Used to build PayFast return/cancel/
# notify URLs, and as the single source for SITE.url (lib/content.js), which
# metadataBase, OG/Twitter image resolution, and the LocalBusiness structured
# data all read from — change it here, not by hunting for hardcoded domains
# across the app.
#
# Optional — leave unset and next.config.js falls back to Vercel's own
# VERCEL_PROJECT_PRODUCTION_URL (the production domain already assigned to
# whichever Vercel project built the deployment), then to localhost for
# local dev. Set this explicitly once a custom domain is connected — no
# code change needed after that, just update this value.
NEXT_PUBLIC_SITE_URL=
